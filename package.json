{
	"name": "xmcp-pokemon",
	"version": "0.1.0",
	"description": "An xmcp application with tool syntax",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "xmcp build",
		"commitlint": "commitlint",
